{
  "name": "@krishaysuresh/inzo",
  "version": "0.1.0",
  "description": "Human-side live viewer for an Inzo pairing: watch two agents negotiate, approve the plan, pull the kill switch.",
  "type": "module",
  "bin": {
    "inzo": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "inzo-relay": "*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "Krishay Suresh",
  "homepage": "https://github.com/krishayyy/inzo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishayyy/inzo.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/krishayyy/inzo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "cli",
    "agent-coordination"
  ],
  "dependencies": {
    "inzo-holder": "*"
  }
}