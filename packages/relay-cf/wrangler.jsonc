{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inzo-relay-cf",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "PAIRING_ROOM", "class_name": "PairingRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registry", "PairingRoom"] }
  ],
  "observability": {
    "enabled": true
  }
}
