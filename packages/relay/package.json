{
  "name": "inzo-relay",
  "version": "0.1.0",
  "description": "Inzo relay: the shared backend two paired coding agents talk through.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentrun/sdk": "^0.0.5",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "author": "Krishay Suresh",
  "homepage": "https://github.com/krishayyy/inzo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishayyy/inzo.git",
    "directory": "packages/relay"
  },
  "bugs": {
    "url": "https://github.com/krishayyy/inzo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai-agents",
    "mcp",
    "a2a",
    "agent-coordination",
    "relay"
  ],
  "bin": {
    "inzo-relay": "dist/index.js"
  }
}
