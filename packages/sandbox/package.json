{
  "name": "inzo-sandbox",
  "version": "0.1.0",
  "description": "Local Docker-based sandbox for executing agent-proposed actions in isolation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docker"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:image": "docker build -t inzo-sandbox -f docker/Dockerfile docker"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.15"
  },
  "license": "Apache-2.0",
  "author": "Krishay Suresh",
  "homepage": "https://github.com/krishayyy/inzo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishayyy/inzo.git",
    "directory": "packages/sandbox"
  },
  "bugs": {
    "url": "https://github.com/krishayyy/inzo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "sandbox",
    "docker",
    "isolation",
    "mcp"
  ]
}
